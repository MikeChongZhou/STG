{
  "name": "screenguardian-desktop",
  "version": "1.0.7",
  "description": "ScreenGuardian - Cross-platform screen time manager (Desktop)",
  "author": "TimberTrail",
  "license": "MIT",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "tsc && electron .",
    "dev": "tsc -w & electron .",
    "pack": "tsc && electron-builder --dir",
    "dist": "tsc && electron-builder",
    "dist:win": "tsc && electron-builder --win",
    "dist:mac": "tsc && electron-builder --mac"
  },
  "dependencies": {
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0",
    "typescript": "^5.3.0",
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.0"
  },
  "build": {
    "appId": "com.timbertrail.screenguardian",
    "productName": "ScreenGuardian",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "ui/**/*"
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "ui/icons/icon.ico"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "ui/icons/icon.icns"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
